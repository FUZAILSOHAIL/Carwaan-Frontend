# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit real keys.
#
# A variable exported in the environment overrides the value in .env.
# The Android build reads these when Gradle configures the app module.

# Google Maps SDK key for Android (com.google.android.geo.API_KEY).
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Android API key. Written into generated google-services.json as current_key.
FIREBASE_API_KEY=your-firebase-api-key

# Google OAuth client ID injected as the googleClientId manifest placeholder.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
